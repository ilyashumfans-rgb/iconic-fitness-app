# syntax=docker/dockerfile:1
# ---- API server (Express + Drizzle + Postgres) ----
# Built from the monorepo root context so pnpm workspace resolution works.

FROM node:24-slim AS build
RUN corepack enable
WORKDIR /app

# Copy the whole workspace (node_modules/dist excluded via .dockerignore),
# install all workspace deps, then build the api-server bundle.
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @workspace/api-server run build

FROM node:24-slim AS runtime
RUN corepack enable
ENV NODE_ENV=production
WORKDIR /app

# Bring the built bundle plus installed dependencies.
COPY --from=build /app /app
WORKDIR /app/artifacts/api-server

# PORT is supplied at runtime (see docker-compose.yml). The server reads it.
EXPOSE 5000
CMD ["node", "--enable-source-maps", "./dist/index.mjs"]
