# syntax=docker/dockerfile:1
# ---- Web frontend (Vite React SPA, served by nginx) ----
# Built from the monorepo root context.

FROM node:24-slim AS build
RUN corepack enable
WORKDIR /app

# Vite inlines VITE_* env at BUILD time, so the Clerk publishable key must be
# passed as a build arg. BASE_PATH defaults to "/" for a standalone deployment.
ARG VITE_CLERK_PUBLISHABLE_KEY=""
ARG BASE_PATH="/"
ENV VITE_CLERK_PUBLISHABLE_KEY=$VITE_CLERK_PUBLISHABLE_KEY
ENV BASE_PATH=$BASE_PATH
ENV NODE_ENV=production

COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @workspace/gymco run build

FROM nginx:alpine AS runtime
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
# Vite build output dir is dist/public (see vite.config.ts).
COPY --from=build /app/artifacts/gymco/dist/public /usr/share/nginx/html
EXPOSE 80
