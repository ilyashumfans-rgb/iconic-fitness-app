# ----------------------------------------------------------------------------
# Iconic Fitness — environment for the Docker stack (docker-compose.yml)
# Copy this file to ".env" and fill in real values, then: docker compose up --build
# ----------------------------------------------------------------------------

# --- Postgres (used by the db service and the API connection string) ---
POSTGRES_USER=iconic
POSTGRES_PASSWORD=iconic
POSTGRES_DB=iconic

# --- API server ---
# Long random string used to sign admin/partner/staff session cookies.
# Generate one with:  openssl rand -hex 32
SESSION_SECRET=

# Optional log verbosity: trace | debug | info | warn | error
LOG_LEVEL=info

# --- Clerk authentication (member sign-in) ---
# Bring your OWN Clerk application keys from https://dashboard.clerk.com.
# The Replit-managed Clerk instance and its proxy do NOT apply when self-hosting.
#
# Backend secret key (server):
CLERK_SECRET_KEY=
# Publishable key — set the SAME value in both vars below.
# Backend uses CLERK_PUBLISHABLE_KEY; the frontend build needs VITE_CLERK_PUBLISHABLE_KEY.
CLERK_PUBLISHABLE_KEY=
VITE_CLERK_PUBLISHABLE_KEY=
